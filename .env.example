# URL publique du site (balises canoniques, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://au-bon-fournil.vercel.app

# Envoi des demandes de commande par email (optionnel, via resend.com)
# Sans ces variables, le formulaire affiche un récapitulatif et invite à appeler.
RESEND_API_KEY=
ORDER_EMAIL_TO=
# Expéditeur vérifié chez Resend (sinon onboarding@resend.dev, limité aux tests)
ORDER_EMAIL_FROM=
